SVA_APP_ENV=development
SVA_LOG_LEVEL=INFO
# 系統診斷會使用合成內容實際測試 LLM／TTS，並由瀏覽器測試 ASR WebSocket。
SVA_SYSTEM_DIAGNOSTICS_ENABLED=true
SVA_SYSTEM_DIAGNOSTICS_TIMEOUT_SECONDS=30
SVA_LLM_BASE_URL=http://127.0.0.1:12345/v1
# Docker 內若 LLM 不在宿主機預設 port，可改成公司 API DNS。
# SVA_LLM_DOCKER_BASE_URL=http://host.docker.internal:12345/v1
SVA_LLM_ADMIN_URL=http://127.0.0.1:12345/admin
# 僅保存於未納入版控的本機 .env。
SVA_LLM_ADMIN_PASSWORD=
# Phase 3 回答模式：exact（預設）、shadow_llm、controlled_llm 或 fixed_message。
SVA_ANSWER_MODE=exact
# shadow_llm／controlled_llm 啟用前必填，且模型須先通過離線安全評測。
SVA_ANSWER_LLM_MODEL=
SVA_ANSWER_LLM_TIMEOUT_SECONDS=8
SVA_ANSWER_LLM_MAX_TOKENS=768
# 語音客服自然對話模式；沿用回答模型，只使用核准標準答案與通話內有限上下文。
SVA_NATURAL_ANSWER_ENABLED=false
# 僅限 development 的語音測試診斷；會記錄非敏感問答全文，正式環境不會生效。
SVA_VOICE_TEST_CONTENT_LOGGING_ENABLED=false
# Shadow 背景工作含執行中工作的最大容量；同一知識版本會在程序內去重。
SVA_SHADOW_MAX_PENDING=8
# 僅供離線 groundedness 評測，不進入線上回答流程。
SVA_ANSWER_JUDGE_MODEL=
SVA_ANSWER_JUDGE_TIMEOUT_SECONDS=15
# 僅保存於未納入版控的本機 .env；與管理介面密碼分開設定。
SVA_LLM_API_KEY=
# auto：GPT-OSS 使用強制 Tool Call，其他模型使用 OpenAI JSON Schema。
SVA_LLM_STRUCTURED_OUTPUT_MODE=auto
# Phase 3.1 意圖路由：disabled（預設）、shadow 或 controlled。
SVA_INTENT_ROUTER_MODE=disabled
# shadow／controlled 啟用前必填，模型須通過意圖及風險評測。
SVA_INTENT_LLM_MODEL=
SVA_INTENT_LLM_TIMEOUT_SECONDS=8
# GPT-OSS 需保留推理後產生完整 Tool Call 的輸出空間。
SVA_INTENT_LLM_MAX_TOKENS=768
SVA_INTENT_ROUTER_MINIMUM_CONFIDENCE=0.8
# 自然對話追問語意解析：disabled（預設）、shadow 或 controlled。
SVA_CONVERSATION_SEMANTIC_MODE=disabled
SVA_CONVERSATION_LLM_MODEL=
SVA_CONVERSATION_LLM_TIMEOUT_SECONDS=8
SVA_CONVERSATION_LLM_MAX_TOKENS=768
SVA_CONVERSATION_SEMANTIC_MINIMUM_CONFIDENCE=0.85
# 即時語音 Demo；瀏覽器使用 public URL 直連即時 ASR，後端使用 TTS URL。
SVA_VOICE_ENABLED=false
SVA_TTS_BASE_URL=http://127.0.0.1:8000/v1
# Docker 內的 TTS API 位址；與瀏覽器使用的 SVA_AUDIO_PUBLIC_BASE_URL 分開。
# SVA_TTS_DOCKER_BASE_URL=http://host.docker.internal:8000/v1
SVA_AUDIO_PUBLIC_BASE_URL=http://127.0.0.1:8000/v1
SVA_ASR_MODEL=mlx-community/Qwen3-ASR-1.7B-8bit
SVA_ASR_CANDIDATE_MODEL=mlx-community/whisper-large-v3-turbo-asr-fp16
SVA_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-Base-6bit
SVA_TTS_VOICE=Vivian
# Base voice clone 才需要；參考音檔路徑與逐字稿只能放在被 Git 忽略的 .env。
SVA_TTS_REF_AUDIO=
SVA_TTS_REF_TEXT=
SVA_VOICE_TIMEOUT_SECONDS=180
# 通過個資與確定性政策後，慢回答超過此毫秒數才播放預載等待提示音。
SVA_VOICE_ACKNOWLEDGEMENT_DELAY_MS=450
# ASR 判定句尾後再等待的毫秒數；期間若使用者繼續說話會取消送出。
SVA_ASR_ENDPOINT_GRACE_MS=1200
# AI 語音播放期間自動偵測客戶插話；模式為 sensitive、standard、resistant。
SVA_BARGE_IN_ENABLED=true
SVA_BARGE_IN_DEFAULT_MODE=standard
SVA_DATABASE_URL=postgresql+psycopg://sva:sva-dev-only@127.0.0.1:5433/securities_voice_assistant
SVA_KNOWLEDGE_ADMIN_DEV_IDENTITY_ENABLED=true
SVA_RETRIEVAL_MINIMUM_SCORE=0.55
SVA_RETRIEVAL_AMBIGUITY_MARGIN=0.08
SVA_RETRIEVAL_MODE=lexical
SVA_EMBEDDINGS_BASE_URL=http://127.0.0.1:12345/v1
# Docker 內若 embeddings 不在預設的 host.docker.internal:12345，可另設此 Compose 變數。
# SVA_EMBEDDINGS_DOCKER_BASE_URL=http://host.docker.internal:12345/v1
# hybrid 模式啟用前必填，應填入已完成繁體中文證券語料評測的本機 embedding model ID。
SVA_EMBEDDINGS_MODEL=
# 僅保存於未納入版控的本機 .env；不記錄在 log、文件或測試資料。
SVA_EMBEDDINGS_API_KEY=
SVA_EMBEDDINGS_TIMEOUT_SECONDS=5
# 依模型官方說明設定；Qwen3 Embedding 建議 query instruction，multilingual-e5 則使用 query:／passage:。
SVA_EMBEDDINGS_QUERY_PREFIX=
SVA_EMBEDDINGS_DOCUMENT_PREFIX=
SVA_HYBRID_RETRIEVAL_MINIMUM_SCORE=0.4
SVA_HYBRID_RETRIEVAL_AMBIGUITY_MARGIN=0.02
SVA_KNOWLEDGE_ADMIN_URL=http://127.0.0.1:8081/admin/knowledge
# orchestrator 容器內健康檢查使用；瀏覽器連結仍使用上一行的 public URL。
SVA_KNOWLEDGE_ADMIN_INTERNAL_URL=http://knowledge-admin:8081/admin/knowledge
SVA_VOICE_TEST_URL=http://127.0.0.1:8080/voice-test
SVA_SYSTEM_DIAGNOSTICS_URL=http://127.0.0.1:8080/system-diagnostics
