{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/knowledge-item.schema.json",
  "title": "KnowledgeItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_id",
    "title",
    "standard_answer",
    "source_id",
    "source_uri",
    "source_locator",
    "source_type",
    "author",
    "version",
    "status",
    "public_answer_allowed",
    "allowed_intents",
    "prohibited_extensions"
  ],
  "properties": {
    "knowledge_id": {"type": "string", "pattern": "^K-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "standard_answer": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "source_uri": {"type": ["string", "null"], "format": "uri"},
    "source_locator": {"type": "string", "minLength": 1},
    "source_type": {
      "enum": ["official_web", "approved_internal_faq", "local_import"]
    },
    "products": {"type": "array", "items": {"type": "string"}},
    "platforms": {"type": "array", "items": {"type": "string"}},
    "app_versions": {"type": "array", "items": {"type": "string"}},
    "effective_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "review_at": {"type": ["string", "null"], "format": "date-time"},
    "owner_unit": {"type": ["string", "null"]},
    "author": {"type": "string", "minLength": 1},
    "reviewer": {"type": ["string", "null"]},
    "approver": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "version": {"type": "string", "minLength": 1},
    "change_summary": {"type": "string"},
    "previous_version": {"type": ["string", "null"]},
    "status": {
      "enum": ["draft", "review", "approved", "published", "expired", "revoked"]
    },
    "public_answer_allowed": {"type": "boolean"},
    "allowed_intents": {"type": "array", "items": {"type": "string"}},
    "prohibited_extensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "question_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "question_text", "usage"],
        "properties": {
          "variant_id": {"type": "string", "minLength": 1, "maxLength": 36},
          "question_text": {"type": "string", "minLength": 2, "maxLength": 500},
          "usage": {
            "enum": ["retrieval", "evaluation_only", "excluded"]
          }
        }
      }
    },
    "asr_terms": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term_id", "canonical_term", "aliases"],
        "properties": {
          "term_id": {"type": "string", "minLength": 1, "maxLength": 36},
          "canonical_term": {"type": "string", "minLength": 2, "maxLength": 100},
          "aliases": {
            "type": "array",
            "maxItems": 20,
            "items": {"type": "string", "minLength": 2, "maxLength": 100}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"source_type": {"not": {"const": "local_import"}}},
        "required": ["source_type"]
      },
      "then": {
        "properties": {
          "source_uri": {"type": "string", "format": "uri", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["approved", "published"]}},
        "required": ["status"]
      },
      "then": {
        "required": [
          "effective_at",
          "review_at",
          "owner_unit",
          "reviewer",
          "approver",
          "approved_at"
        ],
        "properties": {
          "effective_at": {"type": "string", "format": "date-time"},
          "review_at": {"type": "string", "format": "date-time"},
          "owner_unit": {"type": "string", "minLength": 1},
          "reviewer": {"type": "string", "minLength": 1},
          "approver": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "published"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"public_answer_allowed": {"const": true}}
      }
    }
  ]
}
